# Required. Create one at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Any chat model ID served by Groq that supports JSON mode.
LLM_MODEL=openai/gpt-oss-120b

# Optional. SQLite by default; use a Postgres URL to persist in production.
DATABASE_URL=sqlite:///./ideagig.db

# The one origin allowed by CORS (no trailing slash).
FRONTEND_ORIGIN=http://localhost:3000
